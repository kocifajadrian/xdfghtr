# Copy to .env and adjust. .env is git-ignored.

# Base URL of the Ubian API. Leave empty to use the built-in mock API (demo mode).
VITE_API_URL=

# Optional. "true" or "false". Default: mock is ON when VITE_API_URL is empty, OFF otherwise.
VITE_USE_MOCK_API=

# With the mock API the demo opens already signed in (handy for a shared link). Set to false to start signed out.
# VITE_DEMO_SIGNED_IN=false
